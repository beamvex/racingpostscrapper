        K[API Gateway]
        L[Lambda: HTML Renderer]
        M[Users]
    end
    
    C --> E
    D --> E
    E --> H
    H --> I
    I --> F
    F --> J
    J --> G
    G --> L
    K --> L
    L --> M
    
    style A fill:#f9f,stroke:#333,stroke-width:2px
    style B fill:#bbf,stroke:#333,stroke-width:2px
    style L fill:#bfb,stroke:#333,stroke-width:2px